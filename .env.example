# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model
GEMINI_MODEL=gemini-3.8-flash

# Junior Agent Owner Name
USER_NAME=사용자

# Google OAuth 2.0 for Gmail (Optional if entered in UI Settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GCP 배포 시 도메인 (예: 34.123.45.67.sslip.io — 비워두면 :80 HTTP)
JUNIOR_DOMAIN=

# 외부 접속 보호용 비밀번호 (설정 시 브라우저 접속 시 비밀번호 요구, 비워두면 바로 접속)
JUNIOR_ACCESS_PASSWORD=
